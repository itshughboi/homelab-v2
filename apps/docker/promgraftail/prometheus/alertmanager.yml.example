global:
  smtp_smarthost: "mailrise.hughboi.cc:8025"
  smtp_from: "alertmanager@hughboi.cc"
  smtp_require_tls: false
  smtp_hello: "alertmanager"

route:
  receiver: discord
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 30m
  routes:
    - receiver: smtp
      match_re:
        severity: .*
      continue: true
    - receiver: ntfy
      match_re:
        severity: .*
      continue: true

receivers:
  - name: discord
    discord_configs:
      # SECRET — do not commit the real value. The live alertmanager.yml is
      # gitignored and stored encrypted as alertmanager.yml.sops. Put the real
      # Discord webhook URL here in the decrypted file only.
      - webhook_url: "https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME"
        send_resolved: true
        title: "{{ .CommonLabels.alertname }} - {{ .Status }}"
        message: "{{ .CommonAnnotations.summary }}"
        content: "{{ .CommonAnnotations.description }}"
        username: "Prometheus"

  - name: smtp
    email_configs:
      - to: "notify@mailrise.xyz"
        send_resolved: true
        headers:
          Subject: "[Prometheus Alert] {{ .CommonLabels.alertname }}"
        html: |
           <b>{{ .CommonLabels.alertname }}</b><br/>
           Status: {{ .Status }}<br/>
           Summary: {{ .CommonAnnotations.summary }}<br/>
           Description: {{ .CommonAnnotations.description }}

  # ntfy — direct receiver (topic: alertmanager). A plain webhook POST would dump
  # raw JSON into ntfy, so ntfy's own templating is used via query params
  # (template=1 + Go-template title/message/priority over the Alertmanager payload)
  # to render clean notifications. priority: resolved=2, critical=5, warning=4,
  # else 3. Anonymous publish is allowed on this ntfy, so no secret here.
  - name: ntfy
    webhook_configs:
      - url: "https://ntfy.hughboi.cc/alertmanager?template=1&title=%7B%7Brange+.alerts%7D%7D%7B%7B.labels.alertname%7D%7D+%28%7B%7B.status%7D%7D%29%7B%7Bend%7D%7D&message=%7B%7Brange+.alerts%7D%7D%7B%7B.annotations.summary%7D%7D%7B%7Bif+.annotations.description%7D%7D%0A%7B%7B.annotations.description%7D%7D%7B%7Bend%7D%7D%0A%7B%7Bend%7D%7D&priority=%7B%7Bif+eq+.status+%22resolved%22%7D%7D2%7B%7Belse+if+eq+%28index+.alerts+0%29.labels.severity+%22critical%22%7D%7D5%7B%7Belse+if+eq+%28index+.alerts+0%29.labels.severity+%22warning%22%7D%7D4%7B%7Belse%7D%7D3%7B%7Bend%7D%7D&tags=warning"
        send_resolved: true
