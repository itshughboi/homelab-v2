global:
  smtp_smarthost: "mailrise.hughboi.cc:8025"
  smtp_from: "alertmanager@hughboi.cc"
  smtp_require_tls: false
  smtp_hello: "alertmanager"

route:
  receiver: discord
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 30m
  routes:
    - receiver: smtp
      match_re:
        severity: .*
      continue: true
    - receiver: ntfy
      match_re:
        severity: .*
      continue: true

receivers:
  - name: discord
    discord_configs:
      # SECRET — do not commit the real value. The live alertmanager.yml is
      # gitignored and stored encrypted as alertmanager.yml.sops. Put the real
      # Discord webhook URL here in the decrypted file only.
      - webhook_url: "https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME"
        send_resolved: true
        title: "{{ .CommonLabels.alertname }} - {{ .Status }}"
        message: "{{ .CommonAnnotations.summary }}"
        content: "{{ .CommonAnnotations.description }}"
        username: "Prometheus"

  - name: smtp
    email_configs:
      - to: "notify@mailrise.xyz"
        send_resolved: true
        headers:
          Subject: "[Prometheus Alert] {{ .CommonLabels.alertname }}"
        html: |
           <b>{{ .CommonLabels.alertname }}</b><br/>
           Status: {{ .Status }}<br/>
           Summary: {{ .CommonAnnotations.summary }}<br/>
           Description: {{ .CommonAnnotations.description }}

  # ntfy — direct receiver (topic: alertmanager). ntfy natively parses the
  # Alertmanager webhook payload into clean per-alert notifications. Anonymous
  # publish is allowed on this ntfy, so no secret/URL to hide here.
  - name: ntfy
    webhook_configs:
      - url: "https://ntfy.hughboi.cc/alertmanager"
        send_resolved: true
