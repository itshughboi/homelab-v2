{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "DNS — Overview",
  "uid": "dns-overview",
  "tags": ["dns", "adguard", "unbound"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROM", "label": "Prometheus", "type": "datasource",
        "query": "prometheus",
        "current": { "text": "prometheus", "value": "be3h9i5t3zoxsd" }, "hide": 0
      },
      {
        "name": "DS_LOKI", "label": "Loki", "type": "datasource",
        "query": "loki",
        "current": { "text": "loki", "value": "feq5ypvk39gqoe" }, "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100, "type": "row", "title": "AdGuard (client-facing)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1, "type": "stat", "title": "Queries (range)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "sum(count_over_time({job=\"adguard-queries\"} [$__range]))" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 2, "type": "stat", "title": "Blocked (range)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "sum(count_over_time({job=\"adguard-queries\", blocked=\"true\"} [$__range]))" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } }
    },
    {
      "id": 3, "type": "stat", "title": "Block rate %",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "100 * sum(count_over_time({job=\"adguard-queries\", blocked=\"true\"} [$__range])) / sum(count_over_time({job=\"adguard-queries\"} [$__range]))" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 30 } ] } } }
    },
    {
      "id": 4, "type": "stat", "title": "Distinct clients",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "count(sum by (client) (count_over_time({job=\"adguard-queries\"} [$__range])))" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "AdGuard queries — allowed vs blocked",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 5 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "legendFormat": "allowed", "expr": "sum(count_over_time({job=\"adguard-queries\", blocked=\"false\"} [$__interval]))" },
        { "refId": "B", "legendFormat": "blocked", "expr": "sum(count_over_time({job=\"adguard-queries\", blocked=\"true\"} [$__interval]))" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [ { "matcher": { "id": "byName", "options": "blocked" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }, { "matcher": { "id": "byName", "options": "allowed" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] } ] }
    },
    {
      "id": 6, "type": "table", "title": "Top clients",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "instant": true, "expr": "topk(10, sum by (client) (count_over_time({job=\"adguard-queries\"} [$__range])))" } ],
      "transformations": [ { "id": "labelsToFields", "options": {} }, { "id": "organize", "options": { "excludeByName": { "Time": true } } } ]
    },
    {
      "id": 200, "type": "row", "title": "Unbound (recursive resolver)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 } },
    {
      "id": 7, "type": "stat", "title": "Unbound up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "unbound_up" } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "id": 8, "type": "stat", "title": "Cache hit ratio (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "100 * sum(rate(unbound_cache_hits_total[5m])) / clamp_min(sum(rate(unbound_cache_hits_total[5m])) + sum(rate(unbound_cache_misses_total[5m])), 1)" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 } ] } } }
    },
    {
      "id": 9, "type": "stat", "title": "Queries/sec (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "sum(rate(unbound_queries_total[5m]))" } ],
      "fieldConfig": { "defaults": { "unit": "qps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "purple" } } }
    },
    {
      "id": 10, "type": "stat", "title": "Avg recursion time",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "avg(unbound_recursion_time_seconds_avg)" } ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.5 } ] } } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Unbound cache hits vs misses /s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [
        { "refId": "A", "legendFormat": "hits", "expr": "sum(rate(unbound_cache_hits_total[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "misses", "expr": "sum(rate(unbound_cache_misses_total[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "qps", "custom": { "drawStyle": "line", "fillOpacity": 20 } }, "overrides": [ { "matcher": { "id": "byName", "options": "hits" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }, { "matcher": { "id": "byName", "options": "misses" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] } ] }
    },
    {
      "id": 12, "type": "timeseries", "title": "Unbound response time percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum(rate(unbound_response_time_seconds_bucket[$__rate_interval])) by (le))" },
        { "refId": "B", "legendFormat": "p99", "expr": "histogram_quantile(0.99, sum(rate(unbound_response_time_seconds_bucket[$__rate_interval])) by (le))" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    }
  ]
}
