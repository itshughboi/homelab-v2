{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Homelab — Overview",
  "uid": "homelab-overview",
  "tags": ["overview", "homelab"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROM", "label": "Prometheus", "type": "datasource",
        "query": "prometheus",
        "current": { "text": "prometheus", "value": "be3h9i5t3zoxsd" }, "hide": 0
      },
      {
        "name": "DS_LOKI", "label": "Loki", "type": "datasource",
        "query": "loki",
        "current": { "text": "loki", "value": "feq5ypvk39gqoe" }, "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100, "type": "row", "title": "At a glance", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 1, "type": "stat", "title": "Services up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "sum(up)" } ],
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" } } }
    },
    {
      "id": 2, "type": "stat", "title": "Services down",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "count(up == 0)" } ],
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } }
    },
    {
      "id": 3, "type": "gauge", "title": "CPU busy",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\", instance=\"dock-prod\"}[5m])) * 100)" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 } ] } } }
    },
    {
      "id": 4, "type": "gauge", "title": "Memory used",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"dock-prod\"} / node_memory_MemTotal_bytes{instance=\"dock-prod\"})" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 } ] } } }
    },
    {
      "id": 5, "type": "stat", "title": "Root disk free",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "node_filesystem_avail_bytes{instance=\"dock-prod\", mountpoint=\"/\"}" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 10000000000 }, { "color": "green", "value": 50000000000 } ] } } }
    },
    {
      "id": 6, "type": "stat", "title": "Crowdsec bans",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "sum(cs_active_decisions{action=\"ban\"})" } ],
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 50 } ] } } }
    },
    {
      "id": 7, "type": "gauge", "title": "GPU busy",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "max(intel_gpu_engine_busy_percent)" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 } ] } } }
    },
    {
      "id": 8, "type": "stat", "title": "GPU up",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "intel_gpu_up" } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "id": 9, "type": "stat", "title": "Root disk used",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{instance=\"dock-prod\", mountpoint=\"/\"} / node_filesystem_size_bytes{instance=\"dock-prod\", mountpoint=\"/\"})" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 } ] } } }
    },
    {
      "id": 10, "type": "stat", "title": "Load1",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "node_load1{instance=\"dock-prod\"}" } ],
      "fieldConfig": { "defaults": { "decimals": 2, "color": { "mode": "fixed", "fixedColor": "purple" } } }
    },
    {
      "id": 11, "type": "stat", "title": "Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "time() - node_boot_time_seconds{instance=\"dock-prod\"}" } ],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 12, "type": "gauge", "title": "Unbound cache hit",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "100 * sum(rate(unbound_cache_hits_total[5m])) / clamp_min(sum(rate(unbound_cache_hits_total[5m])) + sum(rate(unbound_cache_misses_total[5m])), 1)" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 } ] } } }
    },
    {
      "id": 200, "type": "row", "title": "Services", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },
    {
      "id": 13, "type": "table", "title": "Services down",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "instant": true, "format": "table", "expr": "up == 0" } ],
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "Value": true }, "renameByName": { "job": "job", "instance": "instance" } } } ],
      "fieldConfig": { "defaults": {} }
    },
    {
      "id": 14, "type": "stat", "title": "Unbound up",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "unbound_up" } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "id": 15, "type": "stat", "title": "Total targets",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "count(up)" } ],
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 300, "type": "row", "title": "Host — dock-prod", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 } },
    {
      "id": 16, "type": "timeseries", "title": "CPU busy %",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "legendFormat": "cpu busy", "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\", instance=\"dock-prod\"}[$__rate_interval])) * 100)" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 20 }, "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 17, "type": "timeseries", "title": "Memory used %",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "legendFormat": "mem used", "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=\"dock-prod\"} / node_memory_MemTotal_bytes{instance=\"dock-prod\"})" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 20 }, "color": { "mode": "fixed", "fixedColor": "orange" } } }
    },
    {
      "id": 18, "type": "timeseries", "title": "Load average",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [
        { "refId": "A", "legendFormat": "1m", "expr": "node_load1{instance=\"dock-prod\"}" },
        { "refId": "B", "legendFormat": "5m", "expr": "node_load5{instance=\"dock-prod\"}" },
        { "refId": "C", "legendFormat": "15m", "expr": "node_load15{instance=\"dock-prod\"}" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 400, "type": "row", "title": "DNS — AdGuard", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 } },
    {
      "id": 19, "type": "stat", "title": "Total queries (range)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 26 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "sum(count_over_time({job=\"adguard-queries\"} [$__range]))" } ],
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 20, "type": "stat", "title": "Block rate %",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 26 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "100 * sum(count_over_time({job=\"adguard-queries\", blocked=\"true\"} [$__range])) / sum(count_over_time({job=\"adguard-queries\"} [$__range]))" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 30 } ] } } }
    },
    {
      "id": 21, "type": "timeseries", "title": "AdGuard queries — allowed vs blocked",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        { "refId": "A", "legendFormat": "allowed", "expr": "sum(count_over_time({job=\"adguard-queries\", blocked=\"false\"} [$__interval]))" },
        { "refId": "B", "legendFormat": "blocked", "expr": "sum(count_over_time({job=\"adguard-queries\", blocked=\"true\"} [$__interval]))" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [ { "matcher": { "id": "byName", "options": "blocked" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }, { "matcher": { "id": "byName", "options": "allowed" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] } ] }
    }
  ]
}
