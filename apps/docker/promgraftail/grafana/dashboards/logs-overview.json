{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Logs — Overview",
  "uid": "logs-overview",
  "tags": ["logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_LOKI", "label": "Loki", "type": "datasource",
        "query": "loki",
        "current": { "text": "loki", "value": "feq5ypvk39gqoe" }, "hide": 0
      },
      {
        "name": "service", "label": "Service", "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": { "label": "compose_service", "type": 1 },
        "refresh": 2, "includeAll": true, "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Log lines (range)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "sum(count_over_time({compose_service=~\"$service\"} [$__range]))" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 2, "type": "stat", "title": "Errors (range)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "sum(count_over_time({compose_service=~\"$service\"} |~ `(?i)\\berror\\b|\\bfatal\\b|\\bpanic\\b` [$__range]))" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } }
    },
    {
      "id": 3, "type": "stat", "title": "Services logging",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "count(sum by (compose_service) (count_over_time({compose_service=~\"$service\"} [$__range])))" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } }
    },
    {
      "id": 4, "type": "stat", "title": "Error lines /s (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "queryType": "instant", "expr": "sum(rate({compose_service=~\"$service\"} |~ `(?i)\\berror\\b|\\bfatal\\b|\\bpanic\\b` [5m]))" } ],
      "fieldConfig": { "defaults": { "decimals": 3, "color": { "mode": "fixed", "fixedColor": "orange" } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Log volume by service",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "legendFormat": "{{compose_service}}", "expr": "sum by (compose_service) (count_over_time({compose_service=~\"$service\"} [$__interval]))" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 50, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Error/warn rate by service",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "legendFormat": "{{compose_service}}", "expr": "sum by (compose_service) (count_over_time({compose_service=~\"$service\"} |~ `(?i)\\berror\\b|\\bfatal\\b|\\bpanic\\b|\\bwarn\\b` [$__interval]))" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20 } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } }
    },
    {
      "id": 7, "type": "table", "title": "Top services by error count",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [ { "refId": "A", "instant": true, "expr": "topk(15, sum by (compose_service) (count_over_time({compose_service=~\"$service\"} |~ `(?i)\\berror\\b|\\bfatal\\b|\\bpanic\\b` [$__range])))" } ],
      "transformations": [ { "id": "labelsToFields", "options": {} }, { "id": "organize", "options": { "excludeByName": { "Time": true } } } ]
    },
    {
      "id": 8, "type": "logs", "title": "Error / fatal / panic feed (all services)",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 13 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": { "showTime": true, "wrapLogMessage": true, "dedupStrategy": "none", "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [ { "refId": "A", "expr": "{compose_service=~\"$service\"} |~ `(?i)\\berror\\b|\\bfatal\\b|\\bpanic\\b`" } ]
    }
  ]
}
