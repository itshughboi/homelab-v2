{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Intel Arc A380 — GPU",
  "uid": "intel-arc-gpu",
  "tags": ["gpu", "intel", "arc", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROM", "label": "Prometheus", "type": "datasource",
        "query": "prometheus",
        "current": { "text": "prometheus", "value": "be3h9i5t3zoxsd" }, "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 10, "type": "text", "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": { "mode": "markdown", "content": "**Intel Arc A380** shared by Jellyfin (transcode) and Immich ML/eros. `intel_gpu_top` reports GPU utilization **globally, not per-container** — but the engine tells you the workload: **Video / VideoEnhance = Jellyfin transcoding**, **Render/3D / Compute = Immich ML inference**. Blitter = memory copies." }
    },
    {
      "id": 1, "type": "stat", "title": "GPU up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "intel_gpu_up" } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Overall busy (max engine)",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "max(intel_gpu_engine_busy_percent)" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 90 } ] } } }
    },
    {
      "id": 3, "type": "stat", "title": "Frequency (actual)",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "intel_gpu_frequency_mhz{type=\"actual\"}" } ],
      "fieldConfig": { "defaults": { "unit": "rotmhz", "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 4, "type": "stat", "title": "RC6 idle %",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "intel_gpu_rc6_percent" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 40 }, { "color": "green", "value": 80 } ] } } }
    },
    {
      "id": 5, "type": "stat", "title": "GPU clients",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "intel_gpu_clients" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" } } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Engine utilization %",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "legendFormat": "{{engine}}", "expr": "intel_gpu_engine_busy_percent" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 25 } }, "overrides": [
        { "matcher": { "id": "byName", "options": "Video" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
        { "matcher": { "id": "byName", "options": "VideoEnhance" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "super-light-green" } } ] },
        { "matcher": { "id": "byName", "options": "Compute" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
        { "matcher": { "id": "byName", "options": "Render/3D" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
      ] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Transcode (Jellyfin) vs Compute (Immich ML)",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [
        { "refId": "A", "legendFormat": "transcode (video engines)", "expr": "max(intel_gpu_engine_busy_percent{engine=~\"Video|VideoEnhance\"})" },
        { "refId": "B", "legendFormat": "compute (render+compute)", "expr": "max(intel_gpu_engine_busy_percent{engine=~\"Compute|Render/3D\"})" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 30 } }, "overrides": [
        { "matcher": { "id": "byName", "options": "transcode (video engines)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
        { "matcher": { "id": "byName", "options": "compute (render+compute)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
      ] }
    },
    {
      "id": 8, "type": "timeseries", "title": "Frequency (actual vs requested)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "legendFormat": "{{type}}", "expr": "intel_gpu_frequency_mhz" } ],
      "fieldConfig": { "defaults": { "unit": "rotmhz", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 9, "type": "timeseries", "title": "RC6 idle residency % (higher = more idle/power-saving)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "legendFormat": "rc6", "expr": "intel_gpu_rc6_percent" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity" }, "color": { "mode": "fixed", "fixedColor": "blue" } } }
    }
  ]
}
