{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Crowdsec — Security",
  "uid": "crowdsec-security",
  "tags": ["crowdsec", "security", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROM",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "prometheus", "value": "be3h9i5t3zoxsd" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Active decisions (total)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "sum(cs_active_decisions)" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null } ] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Bans",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "sum(cs_active_decisions{action=\"ban\"})" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } }
    },
    {
      "id": 3, "type": "stat", "title": "Alerts parsed /s (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "sum(rate(cs_parser_hits_ok_total[5m]))" } ],
      "fieldConfig": { "defaults": { "decimals": 2, "color": { "mode": "fixed", "fixedColor": "orange" } } }
    },
    {
      "id": 4, "type": "stat", "title": "Bouncer requests /s (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "expr": "sum(rate(cs_lapi_bouncer_requests_total[5m]))" } ],
      "fieldConfig": { "defaults": { "decimals": 2, "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 5, "type": "piechart", "title": "Active bans by reason",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "instant": true, "legendFormat": "{{reason}}", "expr": "sum by (reason) (cs_active_decisions{action=\"ban\"})" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] }, "pieType": "donut" }
    },
    {
      "id": 6, "type": "piechart", "title": "Active bans by origin",
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "instant": true, "legendFormat": "{{origin}}", "expr": "sum by (origin) (cs_active_decisions{action=\"ban\"})" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value"] }, "pieType": "donut" }
    },
    {
      "id": 7, "type": "table", "title": "Top ban reasons",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "instant": true, "format": "table", "expr": "sort_desc(sum by (reason) (cs_active_decisions{action=\"ban\"}))" } ],
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true, "action": true, "__name__": true }, "renameByName": { "Value": "bans", "reason": "reason" } } } ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Active decisions over time (by reason)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "legendFormat": "{{reason}}", "expr": "sum by (reason) (cs_active_decisions{action=\"ban\"})" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Parser hits /s (ok vs ko)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [
        { "refId": "A", "legendFormat": "ok", "expr": "sum(rate(cs_parser_hits_ok_total[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "ko", "expr": "sum(rate(cs_parser_hits_ko_total[$__rate_interval]))" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [ { "matcher": { "id": "byName", "options": "ko" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] }
    },
    {
      "id": 10, "type": "timeseries", "title": "LAPI requests /s (by route)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "legendFormat": "{{route}}", "expr": "sum by (route) (rate(cs_lapi_route_requests_total[$__rate_interval]))" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Acquisition source hits /s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "targets": [ { "refId": "A", "legendFormat": "{{source}}", "expr": "sum by (source) (rate(cs_filesource_hits_total[$__rate_interval]))" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    }
  ]
}
