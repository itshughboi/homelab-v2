/*
 * Grafana Alloy — replaces Promtail for this stack (Phase 2).
 *
 * This is a faithful port of promtail/config.yaml (logs only), preserving the
 * same log streams so nothing is lost in the switch:
 *   - dock-prod host /var/log/*log
 *   - docker container logs
 *   - bind9 syslog receiver on :1514
 *   - AdGuard query log (JSON) with the same field extraction / labels
 *
 * Optional host + docker METRICS sections (unix exporter, cadvisor) are included
 * but commented out — enabling them is a separate decision from the promtail swap.
 */

// ── Output: Loki ────────────────────────────────────────────────────────────
// Internal endpoint (alloy runs on the promgraftail network). Matches promtail's
// push target (which used the public URL; internal is faster and avoids Traefik).
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ── dock-prod host /var/log ─────────────────────────────────────────────────
// Promtail job: dock-prod_system -> label job=dock-prod_varlogs, path /var/log/*log.
local.file_match "varlogs" {
  path_targets = [{
    __address__ = "localhost",
    __path__    = "/var/log/*log",
    job         = "dock-prod_varlogs",
    host        = "dock-prod",
  }]
}

loki.source.file "varlogs" {
  targets    = local.file_match.varlogs.targets
  forward_to = [loki.write.default.receiver]
}

// ── Docker container logs: intentionally NOT scraped here ───────────────────
// Every container in this homelab already ships its stdout to Loki via the
// Docker `loki` logging driver (labels: container_name / compose_service).
// A loki.source.docker here would DOUBLE-ship every container's logs under a
// second label set (platform=docker / service_name). Promtail's old docker
// scrape was likewise redundant. So Alloy deliberately omits it — the loki
// driver remains the single source of docker logs.

// ── bind9 syslog receiver (:1514) ───────────────────────────────────────────
// Promtail job: bind9 (syslog listener). Alloy uses loki.source.syslog.
loki.source.syslog "bind9" {
  listener {
    address               = "0.0.0.0:1514"
    protocol              = "tcp"
    idle_timeout          = "60s"
    label_structured_data = true
    labels                = {job = "bind9"}
  }
  // Also accept UDP syslog (bind9/devices may send either).
  listener {
    address               = "0.0.0.0:1514"
    protocol              = "udp"
    label_structured_data = true
    labels                = {job = "bind9"}
  }
  forward_to = [loki.write.default.receiver]
}

// ── AdGuard query log (JSON) ────────────────────────────────────────────────
// Port of the adguard-queries job: parse querylog.json, use AdGuard's own
// timestamp, derive blocked from Result.IsFiltered, keep low-cardinality labels
// (client, blocked, qtype). Raw JSON stays as the log body for `| json` in Grafana.
local.file_match "adguard" {
  path_targets = [{
    __address__ = "localhost",
    __path__    = "/adguard-querylog/querylog.json",
    job         = "adguard-queries",
    host        = "dock-prod",
  }]
}

loki.source.file "adguard" {
  targets    = local.file_match.adguard.targets
  forward_to = [loki.process.adguard.receiver]
}

loki.process "adguard" {
  // Extract fields from the JSON line.
  stage.json {
    expressions = {
      timestamp   = "T",
      query       = "QH",
      qtype       = "QT",
      client      = "IP",
      upstream    = "Upstream",
      cached      = "Cached",
      elapsed     = "Elapsed",
      is_filtered = "Result.IsFiltered",
    }
  }
  // Use AdGuard's own RFC3339Nano timestamp.
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }
  // Derive blocked=true/false from Result.IsFiltered.
  stage.template {
    source   = "blocked"
    template = "{{ if eq .is_filtered \"true\" }}true{{ else }}false{{ end }}"
  }
  // Low-cardinality labels only (domain intentionally stays in the JSON body).
  stage.labels {
    values = {
      client  = "",
      blocked = "",
      qtype   = "",
    }
  }
  forward_to = [loki.write.default.receiver]
}

// ── OPTIONAL: host metrics (unix exporter) → Prometheus ──────────────────────
// New capability beyond promtail. Uncomment to push node metrics to Prometheus
// (Prometheus has --web.enable-remote-write-receiver enabled).
//
// prometheus.exporter.unix "node" {
//   disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]
// }
// discovery.relabel "node" {
//   targets = prometheus.exporter.unix.node.targets
//   rule { target_label = "instance"  replacement = "dock-prod" }
//   rule { target_label = "job"       replacement = "dock-prod-node" }
// }
// prometheus.scrape "node" {
//   targets         = discovery.relabel.node.output
//   forward_to      = [prometheus.remote_write.metrics.receiver]
//   scrape_interval = "15s"
// }
//
// prometheus.remote_write "metrics" {
//   endpoint { url = "http://prometheus:9090/api/v1/write" }
// }
