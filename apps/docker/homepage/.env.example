# Proxmox widget credentials — API token, api@pam!homepage style.
# Same creds used for all pve nodes (only need the token on one node in a cluster).
HOMEPAGE_VAR_PROXMOX_USERNAME=api@pam!homepage
HOMEPAGE_VAR_PROXMOX_PASSWORD="CHANGEME"

# Required since Homepage 3/17/25 — the host(s) Homepage is served on.
HOMEPAGE_ALLOWED_HOSTS=home.hughboi.cc
