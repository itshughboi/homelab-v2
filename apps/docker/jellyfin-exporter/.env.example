# Jellyfin API key for the exporter.
# Create it in Jellyfin: Dashboard > Advanced > API Keys > "+" (name it "prometheus-exporter").
# Then: put the real value here, run `./scripts/sops-migrate.sh jellyfin-exporter`
# to encrypt into .env.sops, and remove the plaintext value from this file.
JELLYFIN_API_KEY=changeme
